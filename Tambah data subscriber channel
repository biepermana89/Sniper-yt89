async function researchKeyword() {
  const q = document.getElementById('kw-input').value.trim();
  if (!q) { showToast('Masukkan kata kunci', true); return; }

  document.getElementById('keyword-results').innerHTML = '<div class="loading"><div class="spinner"></div><div>Menganalisis kata kunci...</div></div>';

  // Search for the keyword to get data
  const data = await ytFetch('search', { part: 'snippet', type: 'video', q, maxResults: 10, order: 'relevance' });
  if (!data?.items) return;

  const ids = data.items.map(i => i.id.videoId).filter(Boolean).join(',');
  const stats = await ytFetch('videos', { part: 'statistics,snippet', id: ids });

  // Generate related keywords with AI
  const lang = state.settings.lang === 'id' ? 'Bahasa Indonesia' : 'English';
  const aiPrompt = `Berikan analisis riset kata kunci YouTube untuk "${q}" dalam ${lang}.
Format respons sebagai JSON array dengan 8 keyword terkait, masing-masing dengan:
- keyword: string
- volume: "Tinggi"/"Sedang"/"Rendah"
- competition: "Tinggi"/"Sedang"/"Rendah"  
- potential: "Tinggi"/"Sedang"/"Rendah"
- tip: string singkat (max 10 kata)
Hanya return JSON array, tanpa teks lain.`;

  const aiResult = await geminiAsk(aiPrompt);
  let keywords = [];
  try {
    const clean = aiResult.replace(/```json|```/g, '').trim();
    keywords = JSON.parse(clean);
  } catch(e) {
    keywords = [{ keyword: q, volume: 'Sedang', competition: 'Sedang', potential: 'Sedang', tip: 'Analisis manual diperlukan' }];
  }

  // Save to state
  if (!state.keywords.includes(q)) {
    state.keywords.push(q);
    localStorage.setItem('keywords', JSON.stringify(state.keywords));
    updateStats();
  }

  const avgViews = stats?.items ? stats.items.reduce((s,i) => s + parseInt(i.statistics.viewCount||0), 0) / stats.items.length : 0;

  let html = `
    <div class="settings-card" style="margin-bottom:14px;">
      <div class="settings-title">📊 Overview: "${q}"</div>
      <div class="video-stats">
        <div class="stat highlight">📹 ${data.pageInfo?.totalResults?.toLocaleString() || '0'} video</div>
        <div class="stat green">👁 Rata-rata ${formatNum(avgViews)} views</div>
      </div>
    </div>
    <div class="settings-card">
      <div class="settings-title">🎯 Keyword Terkait (AI)</div>
      <table class="kw-table">
        <thead><tr>
          <th>Kata Kunci</th><th>Volume</th><th>Kompetisi</th><th>Potensi</th><th>Tips</th>
        </tr></thead>
        <tbody>`;

  keywords.forEach(kw => {
    const compColor = kw.competition === 'Rendah' ? 'low' : kw.competition === 'Sedang' ? 'mid' : 'high';
    const compWidth = kw.competition === 'Rendah' ? '30' : kw.competition === 'Sedang' ? '60' : '90';
    html += `<tr>
      <td><strong>${kw.keyword}</strong></td>
      <td><span style="color:${kw.volume==='Tinggi'?'var(--green)':kw.volume==='Sedang'?'var(--accent)':'var(--text2)'}">${kw.volume}</span></td>
      <td>
        <div class="competition-bar"><div class="competition-fill ${compColor}" style="width:${compWidth}%"></div></div>
        <div style="font-size:10px;color:var(--text2);margin-top:2px;">${kw.competition}</div>
      </td>
      <td><span style="color:${kw.potential==='Tinggi'?'var(--green)':kw.potential==='Sedang'?'var(--accent)':'var(--text2)'}">${kw.potential}</span></td>
      <td style="font-size:11px;color:var(--text2);">${kw.tip}</td>
    </tr>`;
  });

  html += '</tbody></table></div>';
  document.getElementById('keyword-results').innerHTML = html;
}

