// FAVORITES
function toggleFavorite(videoId) {
  const video = state.lastResults.find(v => v.id === videoId);
  if (!video) return;
  const idx = state.favorites.findIndex(f => f.id === videoId);
  if (idx >= 0) {
    state.favorites.splice(idx, 1);
    showToast('Dihapus dari favorit');
  } else {
    state.favorites.push(video);
    showToast('Disimpan ke favorit ⭐');
  }
  localStorage.setItem('favorites', JSON.stringify(state.favorites));
  updateStats();
  const btn = document.getElementById('fav-btn-' + videoId);
  if (btn) btn.textContent = state.favorites.some(f => f.id === videoId) ? '★ Tersimpan' : '☆ Simpan';
  renderFavorites();
}

