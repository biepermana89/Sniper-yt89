<script>
// STATE
let state = {
  ytKey: localStorage.getItem('yt_api_key') || '',
  geminiKey: localStorage.getItem('gemini_api_key') || '',
  searches: parseInt(localStorage.getItem('stat_searches') || '0'),
  analyzed: parseInt(localStorage.getItem('stat_analyzed') || '0'),
  favorites: JSON.parse(localStorage.getItem('favorites') || '[]'),
  keywords: JSON.parse(localStorage.getItem('keywords') || '[]'),
  lastResults: [],
  settings: JSON.parse(localStorage.getItem('settings') || '{"maxResults":24,"lang":"id","vph":true}')
};

// INIT
window.onload = () => {
  if (state.ytKey) document.getElementById('yt-api-key').value = state.ytKey;
  if (state.geminiKey) document.getElementById('gemini-api-key').value = state.geminiKey;
  updateAPIStatus();
  updateStats();
  renderFavorites();
};

function updateAPIStatus() {
  const btn = document.getElementById('api-status-btn');
  const txt = document.getElementById('api-status-text');
  if (state.ytKey) {
    btn.className = 'api-status active';
    txt.textContent = 'API Aktif';
  } else {
    btn.className = 'api-status inactive';
    txt.textContent = 'API Tidak Aktif';
  }
}

function updateStats() {
  document.getElementById('stat-searches').textContent = state.searches;
  document.getElementById('stat-analyzed').textContent = state.analyzed;
  document.getElementById('stat-favorites').textContent = state.favorites.length;
  document.getElementById('stat-keywords').textContent = state.keywords.length;
  document.getElementById('fav-count').textContent = state.favorites.length;
}

// NAVIGATION
function showPage(page) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById('page-' + page).classList.add('active');
  const titles = {
    dashboard: 'Dashboard', pencarian: 'Pencarian Video', live: 'Live Terbaru',
    trending: 'Trending', bulk: 'Bulk Analisis', keyword: 'Riset Kata Kunci',
    niche: 'Niche Finder', channel: 'Analisis Channel', kompetitor: 'Bidik Kompetitor',
    favorit: 'Video Favorit', settings: 'API Keys', pengaturan: 'Pengaturan'
  };
  document.getElementById('page-title').textContent = titles[page] || page;
  event.currentTarget && event.currentTarget.classList.add('active');
}

function refreshPage() { showToast('Halaman diperbarui'); }

// YOUTUBE API
async function ytFetch(endpoint, params) {
  if (!state.ytKey) { showToast('API Key belum diset! Buka menu API Keys.', true); return null; }
  params.key = state.ytKey;
  const url = 'https://www.googleapis.com/youtube/v3/' + endpoint + '?' + new URLSearchParams(params);
  try {
    const res = await fetch(url);
    const data = await res.json();
    if (data.error) { showToast('Error API: ' + data.error.message, true); return null; }
    return data;
  } catch(e) { showToast('Gagal terhubung ke YouTube API', true); return null; }
}

// GEMINI API
async function geminiAsk(prompt) {
  if (!state.geminiKey) return 'Gemini API Key belum diset.';
  try {
    const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent?key=${state.geminiKey}`, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
    });
    const data = await res.json();
    if (data.error) return 'Error Gemini: ' + data.error.message;
    return data.candidates?.[0]?.content?.parts?.[0]?.text || 'Tidak ada respons';
  } catch(e) { return 'Gagal menghubungi Gemini API'; }
}

// CALCULATE VPH
function calcVPH(views, publishedAt) {
  const hours = (Date.now() - new Date(publishedAt)) / 3600000;
  return hours > 0 ? Math.round(views / hours) : 0;
}

function calcViralScore(vph, views) {
  const score = Math.min(100, Math.round((vph / 1000) * 10 + (views / 100000) * 5));
  return score;
}

function formatNum(n) {
  n = parseInt(n) || 0;
  if (n >= 1000000) return (n/1000000).toFixed(1) + 'M';
  if (n >= 1000) return (n/1000).toFixed(1) + 'K';
  return n.toString();
}

function timeAgo(dateStr) {
  const diff = (Date.now() - new Date(dateStr)) / 1000;
  if (diff < 3600) return Math.round(diff/60) + 'm lalu';
  if (diff < 86400) return Math.round(diff/3600) + 'j lalu';
  if (diff < 2592000) return Math.round(diff/86400) + 'h lalu';
  if (diff < 31536000) return Math.round(diff/2592000) + 'bln lalu';
  return Math.round(diff/31536000) + 'thn lalu';
}

function parseDuration(iso) {
  const m = iso.match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
  const h = parseInt(m[1]||0), min = parseInt(m[2]||0), s = parseInt(m[3]||0);
  if (h) return `${h}:${String(min).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
  return `${min}:${String(s).padStart(2,'0')}`;
}

// RENDER VIDEO CARD
function renderVideoCard(video, showSave = true) {
  const vph = calcVPH(video.views, video.publishedAt);
  const viral = calcViralScore(vph, video.views);
  const isFav = state.favorites.some(f => f.id === video.id);
  return `
    <div class="video-card" id="card-${video.id}">
      <div class="video-thumb">
        <img src="${video.thumb}" alt="" loading="lazy" onerror="this.style.background='var(--bg3)'">
        <div class="video-duration">${video.duration || '0:00'}</div>
        <div class="viral-score">${viral}/100</div>
      </div>
      <div class="video-info">
        <div class="video-channel">
          <div class="channel-avatar">${(video.channel||'?')[0].toUpperCase()}</div>
          <div class="channel-name">${video.channel}</div>
        </div>
        <div class="video-title">${video.title}</div>
        <div class="video-stats">
          <div class="stat highlight">👁 ${formatNum(video.views)}</div>
          <div class="stat green">⚡ ${formatNum(vph)} VPH</div>
          <div class="stat">👍 ${formatNum(video.likes)}</div>
          <div class="stat">💬 ${formatNum(video.comments)}</div>
          <div class="stat">🕐 ${timeAgo(video.publishedAt)}</div>
        </div>
        <div class="viral-bar"><div class="viral-fill" style="width:${viral}%"></div></div>
        <div style="font-size:10px;color:var(--text2);margin-bottom:8px;">Viral Score: ${viral}/100</div>
        <div class="video-actions">
          <button class="action-btn" onclick="openAnalysis('${video.id}')">📊 Analisis</button>
          <button class="action-btn" onclick="openTranscript('${video.id}')">📝 Transkrip</button>
          ${showSave ? `<button class="action-btn ${isFav?'':''}\" onclick="toggleFavorite('${video.id}')" id="fav-btn-${video.id}">${isFav?'★ Tersimpan':'☆ Simpan'}</button>` : ''}
        </div>
      </div>
    </div>`;
}

// SEARCH
async function searchVideos() {
  const q = document.getElementById('search-query').value.trim();
  if (!q) { showToast('Masukkan kata kunci dulu', true); return; }

  const region = document.getElementById('search-region').value;
  const category = document.getElementById('search-category').value;
  const duration = document.getElementById('search-duration').value;
  const upload = document.getElementById('search-upload').value;
  const order = document.getElementById('search-order').value;
  const maxResults = state.settings.maxResults || 24;

  document.getElementById('search-results').innerHTML = '<div class="loading"><div class="spinner"></div><div>Mencari video...</div></div>';
  document.getElementById('results-info').style.display = 'none';

  const params = { part: 'snippet', type: 'video', q, maxResults, order };
  if (region) params.regionCode = region;
  if (category) params.videoCategoryId = category;
  if (duration) params.videoDuration = duration;
  if (upload) {
    const now = new Date();
    const map = { hour: 1, today: 24, week: 168, month: 720, year: 8760 };
    const after = new Date(now - map[upload] * 3600000);
    params.publishedAfter = after.toISOString();
  }

  const searchData = await ytFetch('search', params);
  if (!searchData || !searchData.items?.length) {
    document.getElementById('search-results').innerHTML = '<div class="empty-state"><div class="empty-icon">😔</div><div class="empty-title">Tidak Ditemukan</div><div class="empty-sub">Coba kata kunci lain</div></div>';
    return;
  }

  const ids = searchData.items.map(i => i.id.videoId).filter(Boolean).join(',');
  const statsData = await ytFetch('videos', { part: 'statistics,contentDetails,snippet', id: ids });

  if (!statsData) return;

  const videos = statsData.items.map(item => ({
    id: item.id,
    title: item.snippet.title,
    channel: item.snippet.channelTitle,
    thumb: item.snippet.thumbnails?.medium?.url || '',
    publishedAt: item.snippet.publishedAt,
    views: item.statistics.viewCount || 0,
    likes: item.statistics.likeCount || 0,
    comments: item.statistics.commentCount || 0,
    duration: parseDuration(item.contentDetails.duration || 'PT0S'),
    description: item.snippet.description
  }));

  state.lastResults = videos;
  state.searches++;
  localStorage.setItem('stat_searches', state.searches);
  updateStats();

