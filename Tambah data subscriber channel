function renderVideoGrid(videos, containerId) {
  const container = document.getElementById(containerId);
  if (!videos.length) {
    container.innerHTML = '<div class="empty-state"><div class="empty-icon">😔</div><div class="empty-title">Tidak ada video</div></div>';
    return;
  }
  container.innerHTML = '<div class="video-grid">' + videos.map(v => renderVideoCard(v)).join('') + '</div>';
}

function sortByVPH() {
  const sorted = [...state.lastResults].sort((a,b) => calcVPH(b.views, b.publishedAt) - calcVPH(a.views, a.publishedAt));
  renderVideoGrid(sorted, 'search-results');
}

async function exportCSV() {
  if (!state.lastResults.length) { showToast('Tidak ada data untuk diekspor', true); return; }
  const headers = ['Judul','Channel','Views','Likes','Komentar','VPH','Durasi','Upload'];
  const rows = state.lastResults.map(v => [
    `"${v.title.replace(/"/g,'""')}"`, v.channel, v.views, v.likes, v.comments,
    calcVPH(v.views, v.publishedAt), v.duration, v.publishedAt
  ]);
  const csv = [headers, ...rows].map(r => r.join(',')).join('\n');
  const blob = new Blob([csv], {type:'text/csv'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'sniper-yt-export.csv';
  a.click();
  showToast('CSV berhasil diekspor!');
}

