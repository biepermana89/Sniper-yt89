3. Hook yang digunakan di awal
4. Strategi konten yang bisa dipelajari
5. Kata kunci utama yang ditarget
6. Saran jika ingin membuat video serupa`;

  const analysis = await geminiAsk(prompt);
  state.analyzed++;
  localStorage.setItem('stat_analyzed', state.analyzed);
  updateStats();

  document.getElementById('modal-analysis-content').innerHTML = `
    <div style="display:flex;gap:12px;margin-bottom:16px;align-items:flex-start;">
      <img src="${item.snippet.thumbnails?.medium?.url}" style="width:120px;border-radius:8px;">
      <div>
        <div style="font-weight:600;margin-bottom:6px;line-height:1.4;">${item.snippet.title}</div>
        <div style="font-size:12px;color:var(--text2);">${item.snippet.channelTitle}</div>
        <div class="video-stats" style="margin-top:8px;">
          <div class="stat highlight">👁 ${formatNum(item.statistics.viewCount)}</div>
          <div class="stat green">⚡ ${formatNum(vph)} VPH</div>
          <div class="stat">🔥 Viral: ${viral}/100</div>
        </div>
      </div>
    </div>
    <div class="analysis-section">
      <div class="analysis-title">🤖 Analisis Gemini AI</div>
      <div class="analysis-text" style="white-space:pre-wrap;">${analysis}</div>
    </div>
    ${item.snippet.tags?.length ? `
    <div class="analysis-section">
      <div class="analysis-title">🏷 Tags Video</div>
      <div class="tag-list">${item.snippet.tags.map(t => `<div class="tag">${t}</div>`).join('')}</div>
    </div>` : ''}
    <div style="margin-top:16px;">
      <a href="https://youtube.com/watch?v=${videoId}" target="_blank" class="btn btn-accent" style="text-decoration:none;display:inline-block;">▶ Tonton di YouTube</a>
    </div>`;
}

// TRANSCRIPT MODAL
async function openTranscript(videoId) {
  document.getElementById('modal-transcript').classList.add('open');
  document.getElementById('modal-transcript-content').innerHTML = '<div class="loading"><div class="spinner"></div><div>Memuat transkrip...</div></div>';

  // Get video info first
  const data = await ytFetch('videos', { part: 'snippet', id: videoId });
  if (!data?.items?.length) return;
  const item = data.items[0];

  // Try to get captions list
  const captionsData = await ytFetch('captions', { part: 'snippet', videoId });

  const lang = state.settings.lang === 'id' ? 'Bahasa Indonesia' : 'English';
  
  let content = `
    <div style="margin-bottom:16px;">
      <div style="font-weight:600;">${item.snippet.title}</div>
      <div style="font-size:12px;color:var(--text2);margin-top:4px;">${item.snippet.channelTitle}</div>
    </div>`;

  if (captionsData?.items?.length) {
    const captions = captionsData.items;
    content += `
      <div class="analysis-section">
        <div class="analysis-title">📋 Caption Tersedia</div>
        <div class="tag-list">
          ${captions.map(c => `<div class="tag accent">${c.snippet.language} — ${c.snippet.trackKind}</div>`).join('')}
        </div>
      </div>`;
  }

  // AI summary of description as proxy
  const prompt = `Berikan ringkasan konten video YouTube ini dalam ${lang} berdasarkan judul dan deskripsi:
Judul: ${item.snippet.title}
Deskripsi: ${item.snippet.description?.substring(0, 500) || 'Tidak ada deskripsi'}

Buat:
1. Ringkasan isi konten (3-4 kalimat)
2. Poin-poin utama yang kemungkinan dibahas
3. Target audiens video ini`;

  const summary = await geminiAsk(prompt);

  content += `
    <div class="analysis-section">
      <div class="analysis-title">🤖 Ringkasan AI (dari deskripsi)</div>
      <div class="analysis-text" style="white-space:pre-wrap;">${summary}</div>
    </div>
    <div class="analysis-section">
      <div class="analysis-title">📄 Deskripsi Asli</div>
      <div class="transcript-text">${item.snippet.description || 'Tidak ada deskripsi'}</div>
    </div>
    <div style="margin-top:12px;font-size:11px;color:var(--text2);">
      💡 Untuk transkrip lengkap, download ekstensi YouTube Transcript di Chrome
    </div>`;

  document.getElementById('modal-transcript-content').innerHTML = content;
}

// MODAL
function closeModal(id) {
  document.getElementById(id).classList.remove('open');
}

// API KEYS
function saveAPIKeys() {
  state.ytKey = document.getElementById('yt-api-key').value.trim();
  state.geminiKey = document.getElementById('gemini-api-key').value.trim();
  localStorage.setItem('yt_api_key', state.ytKey);
  localStorage.setItem('gemini_api_key', state.geminiKey);
  updateAPIStatus();
  showToast('API Keys berhasil disimpan! ✓');
}

async function testAPIKeys() {
  if (!state.ytKey) { showToast('Masukkan YouTube API Key dulu', true); return; }
  showToast('Menguji koneksi...');
  const data = await ytFetch('videos', { part: 'snippet', chart: 'mostPopular', maxResults: 1 });
  if (data?.items) showToast('✓ YouTube API berhasil terhubung!');
}

function savePengaturan() {
  state.settings.maxResults = parseInt(document.getElementById('setting-maxresults').value);
  state.settings.lang = document.getElementById('setting-lang').value;
  state.settings.vph = document.getElementById('setting-vph').checked;
  localStorage.setItem('settings', JSON.stringify(state.settings));
  showToast('Pengaturan disimpan!');
}

// TOAST
function showToast(msg, error = false) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast' + (error ? ' error' : '') + ' show';
  setTimeout(() => t.className = 'toast' + (error ? ' error' : ''), 3000);
}

// Close modal on overlay click
document.querySelectorAll('.modal-overlay').forEach(el => {
  el.addEventListener('click', e => { if (e.target === el) el.classList.remove('open'); });
});
</script>
