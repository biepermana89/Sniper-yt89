<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sniper YT — YouTube Research Pro</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=DM+Sans:wght@300;400;500;600;700&display=swap');

  :root {
    --bg: #0a0a0f;
    --bg2: #111118;
    --bg3: #1a1a24;
    --border: #2a2a3a;
    --accent: #f0b429;
    --accent2: #e85d04;
    --blue: #4361ee;
    --green: #06d6a0;
    --red: #ef233c;
    --text: #e8e8f0;
    --text2: #8888aa;
    --text3: #5555770;
    --card: #13131e;
    --hover: #1e1e2e;
    --radius: 12px;
    --font: 'DM Sans', sans-serif;
    --mono: 'Space Mono', monospace;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    display: flex;
    height: 100vh;
    overflow: hidden;
  }

  /* SIDEBAR */
  #sidebar {
    width: 240px;
    min-width: 240px;
    background: var(--bg2);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow-y: auto;
    transition: width 0.3s;
  }

  .logo {
    padding: 20px 18px 16px;
    border-bottom: 1px solid var(--border);
  }

  .logo-title {
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 1px;
  }

  .logo-sub {
    font-size: 10px;
    color: var(--text2);
    margin-top: 2px;
    letter-spacing: 0.5px;
  }

  .nav-section {
    padding: 12px 0 4px;
  }

  .nav-label {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--text2);
    padding: 0 18px 6px;
    text-transform: uppercase;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 18px;
    cursor: pointer;
    font-size: 13px;
    color: var(--text2);
    border-left: 2px solid transparent;
    transition: all 0.15s;
    user-select: none;
  }

  .nav-item:hover { background: var(--hover); color: var(--text); }
  .nav-item.active { background: var(--hover); color: var(--accent); border-left-color: var(--accent); }
  .nav-item .icon { width: 16px; text-align: center; font-size: 14px; }

  .nav-badge {
    margin-left: auto;
    background: var(--red);
    color: #fff;
    font-size: 9px;
    padding: 1px 5px;
    border-radius: 10px;
    font-weight: 700;
  }

  .nav-badge.green { background: var(--green); color: #000; }

  /* MAIN */
  #main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* TOPBAR */
  #topbar {
    background: var(--bg2);
    border-bottom: 1px solid var(--border);
    padding: 12px 24px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .page-title {
    font-size: 16px;
    font-weight: 600;
    flex: 1;
  }

  .api-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    padding: 5px 10px;
    border-radius: 20px;
    border: 1px solid var(--border);
    cursor: pointer;
  }

  .api-status.active { border-color: var(--green); color: var(--green); }
  .api-status.inactive { border-color: var(--red); color: var(--red); }
  .api-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

  .btn {
    padding: 7px 14px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all 0.15s;
    font-family: var(--font);
  }

  .btn-accent { background: var(--accent); color: #000; }
  .btn-accent:hover { background: #e0a820; }
  .btn-ghost { background: transparent; color: var(--text2); border: 1px solid var(--border); }
  .btn-ghost:hover { background: var(--hover); color: var(--text); }
  .btn-blue { background: var(--blue); color: #fff; }
  .btn-blue:hover { background: #3451d1; }

  /* CONTENT */
  #content {
    flex: 1;
    overflow-y: auto;
    padding: 20px 24px;
  }

  /* PAGES */
  .page { display: none; }
  .page.active { display: block; }

  /* FILTER BAR */
  .filter-bar {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 18px;
    display: flex;
    gap: 10px;
    align-items: flex-end;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .filter-label {
    font-size: 10px;
    font-weight: 600;
    color: var(--text2);
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .filter-input, .filter-select {
    background: var(--bg3);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 13px;
    font-family: var(--font);
    outline: none;
    transition: border-color 0.15s;
  }

  .filter-input:focus, .filter-select:focus { border-color: var(--accent); }
  .filter-input { width: 220px; }
  .filter-select { min-width: 140px; }
  .filter-select option { background: var(--bg3); }

  /* RESULTS INFO */
  .results-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .results-count {
    font-size: 12px;
    color: var(--text2);
  }

  .results-count span { color: var(--accent); font-weight: 600; }

  .results-actions { display: flex; gap: 8px; }

  /* VIDEO GRID */
  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
  }

  .video-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    cursor: pointer;
    transition: all 0.2s;
  }

  .video-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }

  .video-thumb {
    width: 100%;
    aspect-ratio: 16/9;
    background: var(--bg3);
    position: relative;
    overflow: hidden;
  }

  .video-thumb img { width: 100%; height: 100%; object-fit: cover; }

  .video-duration {
    position: absolute;
    bottom: 6px;
    right: 6px;
    background: rgba(0,0,0,0.85);
    color: #fff;
    font-size: 11px;
    font-family: var(--mono);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .viral-score {
    position: absolute;
    top: 6px;
    left: 6px;
    background: var(--accent);
    color: #000;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 4px;
    font-family: var(--mono);
  }

  .video-info { padding: 12px; }

  .video-channel {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
  }

  .channel-avatar {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--blue);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
  }

  .channel-name {
    font-size: 11px;
    color: var(--text2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .video-title {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    margin-bottom: 10px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .video-stats {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .stat {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: var(--text2);
  }

  .stat.highlight { color: var(--accent); font-weight: 600; }
  .stat.green { color: var(--green); }
  .stat.red { color: var(--red); }

  .viral-bar {
    height: 3px;
    background: var(--bg3);
    border-radius: 2px;
    margin-bottom: 10px;
    overflow: hidden;
  }

  .viral-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--blue), var(--accent));
    border-radius: 2px;
    transition: width 0.5s;
  }

  .video-actions {
    display: flex;
    gap: 6px;
    border-top: 1px solid var(--border);
    padding-top: 10px;
  }

  .action-btn {
    flex: 1;
    padding: 6px;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text2);
    font-size: 11px;
    cursor: pointer;
    text-align: center;
    transition: all 0.15s;
    font-family: var(--font);
  }

  .action-btn:hover { background: var(--hover); color: var(--text); border-color: var(--accent); }

  /* DASHBOARD */
  .dash-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 20px;
  }

  .dash-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px;
  }

  .dash-card-label { font-size: 11px; color: var(--text2); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px; }
  .dash-card-value { font-size: 24px; font-weight: 700; font-family: var(--mono); }
  .dash-card-sub { font-size: 11px; color: var(--text2); margin-top: 4px; }
  .dash-card-value.accent { color: var(--accent); }
  .dash-card-value.green { color: var(--green); }
  .dash-card-value.blue { color: var(--blue); }
  .dash-card-value.red { color: var(--red); }

  /* MODAL */
  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.7);
    z-index: 100;
    align-items: center;
    justify-content: center;
  }

  .modal-overlay.open { display: flex; }

  .modal {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 28px;
    width: 560px;
    max-width: 95vw;
    max-height: 85vh;
    overflow-y: auto;
  }

  .modal-title {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .modal-close {
    cursor: pointer;
    color: var(--text2);
    font-size: 18px;
    background: none;
    border: none;
    color: var(--text2);
    font-family: var(--font);
  }

  .modal-close:hover { color: var(--text); }

  .form-group { margin-bottom: 16px; }
  .form-label { font-size: 12px; font-weight: 600; color: var(--text2); margin-bottom: 6px; display: block; text-transform: uppercase; letter-spacing: 0.5px; }

  .form-input {
    width: 100%;
    background: var(--bg3);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 13px;
    font-family: var(--mono);
    outline: none;
  }

  .form-input:focus { border-color: var(--accent); }
  .form-hint { font-size: 11px; color: var(--text2); margin-top: 5px; }

  /* LOADING */
  .loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    gap: 16px;
    color: var(--text2);
  }

  .spinner {
    width: 32px;
    height: 32px;
    border: 2px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  /* EMPTY STATE */
  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text2);
  }

  .empty-icon { font-size: 40px; margin-bottom: 12px; }
  .empty-title { font-size: 15px; font-weight: 600; color: var(--text); margin-bottom: 6px; }
  .empty-sub { font-size: 13px; }

  /* ANALYSIS MODAL */
  .analysis-section { margin-bottom: 20px; }
  .analysis-title { font-size: 13px; font-weight: 700; color: var(--accent); margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.5px; }
  .analysis-text { font-size: 13px; line-height: 1.7; color: var(--text); }

  .tag-list { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .tag {
    background: var(--bg3);
    border: 1px solid var(--border);
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 11px;
    color: var(--text2);
  }

  .tag.accent { border-color: var(--accent); color: var(--accent); background: rgba(240,180,41,0.1); }

  /* TRANSCRIPT */
  .transcript-text {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    font-size: 13px;
    line-height: 1.8;
    color: var(--text);
    max-height: 300px;
    overflow-y: auto;
    white-space: pre-wrap;
  }

  /* TABS */
  .tabs { display: flex; gap: 0; margin-bottom: 20px; border-bottom: 1px solid var(--border); }
  .tab {
    padding: 10px 18px;
    font-size: 13px;
    cursor: pointer;
    color: var(--text2);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: all 0.15s;
  }
  .tab:hover { color: var(--text); }
  .tab.active { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }

  .tab-content { display: none; }
  .tab-content.active { display: block; }

  /* SCROLLBAR */
  ::-webkit-scrollbar { width: 5px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

  /* KEYWORD TABLE */
  .kw-table { width: 100%; border-collapse: collapse; }
  .kw-table th {
    background: var(--bg3);
    padding: 10px 14px;
    text-align: left;
    font-size: 11px;
    font-weight: 700;
    color: var(--text2);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 1px solid var(--border);
  }
  .kw-table td {
    padding: 10px 14px;
    font-size: 13px;
    border-bottom: 1px solid var(--border);
  }
  .kw-table tr:hover td { background: var(--hover); }

  .competition-bar {
    height: 4px;
    background: var(--bg3);
    border-radius: 2px;
    width: 80px;
    overflow: hidden;
  }
  .competition-fill { height: 100%; border-radius: 2px; }
  .competition-fill.low { background: var(--green); }
  .competition-fill.mid { background: var(--accent); }
  .competition-fill.high { background: var(--red); }

  /* BULK */
  .bulk-input {
    width: 100%;
    height: 120px;
    background: var(--bg3);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 12px;
    border-radius: 8px;
    font-family: var(--mono);
    font-size: 12px;
    resize: vertical;
    outline: none;
    margin-bottom: 12px;
  }
  .bulk-input:focus { border-color: var(--accent); }

  .bulk-result {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    margin-top: 12px;
    font-size: 13px;
    line-height: 1.8;
  }

  /* SETTINGS */
  .settings-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
    margin-bottom: 16px;
  }
  .settings-title { font-size: 14px; font-weight: 700; margin-bottom: 16px; }
  .settings-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }
  .settings-row:last-child { border-bottom: none; padding-bottom: 0; }
  .settings-row-label { font-size: 13px; }
  .settings-row-sub { font-size: 11px; color: var(--text2); margin-top: 2px; }

  .toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: var(--green);
    color: #000;
    padding: 12px 20px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    z-index: 999;
    transform: translateY(80px);
    opacity: 0;
    transition: all 0.3s;
  }
  .toast.show { transform: translateY(0); opacity: 1; }
  .toast.error { background: var(--red); color: #fff; }
</style>
</head>
<body>

<!-- SIDEBAR -->
<div id="sidebar">
  <div class="logo">
    <div class="logo-title">⚡ SNIPER YT</div>
    <div class="logo-sub">YouTube Research Pro</div>
  </div>

  <div class="nav-section">
    <div class="nav-label">Menu Utama</div>
    <div class="nav-item active" onclick="showPage('dashboard')">
      <span class="icon">📊</span> Dashboard
    </div>
    <div class="nav-item" onclick="showPage('pencarian')">
      <span class="icon">🔍</span> Pencarian
    </div>
    <div class="nav-item" onclick="showPage('live')">
      <span class="icon">🔴</span> Live Terbaru
      <span class="nav-badge">LIVE</span>
    </div>
    <div class="nav-item" onclick="showPage('trending')">
      <span class="icon">🔥</span> Trending
    </div>
  </div>

  <div class="nav-section">
    <div class="nav-label">Analisis</div>
    <div class="nav-item" onclick="showPage('bulk')">
      <span class="icon">📦</span> Bulk Analisis
    </div>
    <div class="nav-item" onclick="showPage('keyword')">
      <span class="icon">🎯</span> Kata Kunci
    </div>
    <div class="nav-item" onclick="showPage('niche')">
      <span class="icon">💡</span> Niche Finder
    </div>
  </div>

  <div class="nav-section">
    <div class="nav-label">Tools</div>
    <div class="nav-item" onclick="showPage('channel')">
      <span class="icon">📺</span> Analisis Channel
    </div>
    <div class="nav-item" onclick="showPage('kompetitor')">
      <span class="icon">🎯</span> Bidik Kompetitor
    </div>
    <div class="nav-item" onclick="showPage('favorit')">
      <span class="icon">⭐</span> Video Favorit
    </div>
  </div>

  <div class="nav-section">
    <div class="nav-label">Sistem</div>
    <div class="nav-item" onclick="showPage('settings')">
      <span class="icon">🔑</span> API Keys
    </div>
    <div class="nav-item" onclick="showPage('pengaturan')">
      <span class="icon">⚙️</span> Pengaturan
    </div>
  </div>
</div>

<!-- MAIN -->
<div id="main">
  <div id="topbar">
    <div class="page-title" id="page-title">Dashboard</div>
    <div class="api-status inactive" id="api-status-btn" onclick="showPage('settings')">
      <div class="api-dot"></div>
      <span id="api-status-text">API Tidak Aktif</span>
    </div>
    <button class="btn btn-ghost" onclick="refreshPage()">↻ Refresh</button>
  </div>

  <div id="content">

    <!-- DASHBOARD -->
    <div id="page-dashboard" class="page active">
      <div class="dash-grid">
        <div class="dash-card">
          <div class="dash-card-label">Total Pencarian</div>
          <div class="dash-card-value accent" id="stat-searches">0</div>
          <div class="dash-card-sub">Sesi ini</div>
        </div>
        <div class="dash-card">
          <div class="dash-card-label">Video Dianalisis</div>
          <div class="dash-card-value green" id="stat-analyzed">0</div>
          <div class="dash-card-sub">Total</div>
        </div>
        <div class="dash-card">
          <div class="dash-card-label">Favorit Disimpan</div>
          <div class="dash-card-value blue" id="stat-favorites">0</div>
          <div class="dash-card-sub">Video</div>
        </div>
        <div class="dash-card">
          <div class="dash-card-label">Keyword Tersimpan</div>
          <div class="dash-card-value" id="stat-keywords">0</div>
          <div class="dash-card-sub">Total</div>
        </div>
      </div>

      <div class="dash-card" style="margin-bottom:16px; padding:20px;">
        <div class="settings-title">🚀 Selamat Datang di Sniper YT</div>
        <div style="font-size:13px; color:var(--text2); line-height:1.8;">
          Riset YouTube profesional dengan AI. Mulai dengan memasukkan API Key YouTube dan Gemini di menu <strong style="color:var(--accent)">API Keys</strong>, lalu gunakan fitur Pencarian untuk mulai riset video.
          <br><br>
          <strong style="color:var(--text)">Fitur Utama:</strong><br>
          🔍 Pencarian dengan filter lengkap (lokasi, kategori, durasi, VPH)<br>
          🔥 Video trending real-time<br>
          🤖 Analisis AI dengan Gemini (judul, hook, strategi)<br>
          📝 Transkrip otomatis video<br>
          🎯 Riset kata kunci & kompetitor
        </div>
      </div>

      <div class="dash-card" id="recent-searches-card">
        <div class="settings-title">🕐 Pencarian Terakhir</div>
        <div id="recent-searches" style="font-size:13px; color:var(--text2);">Belum ada pencarian. Mulai cari video di menu Pencarian.</div>
      </div>
    </div>

    <!-- PENCARIAN -->
    <div id="page-pencarian" class="page">
