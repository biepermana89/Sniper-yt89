// BULK ANALISIS
async function bulkAnalyze() {
  const input = document.getElementById('bulk-input').value.trim();
  if (!input) { showToast('Masukkan URL atau ID video dulu', true); return; }

  const lines = input.split('\n').filter(l => l.trim());
  const ids = lines.map(line => {
    const match = line.match(/(?:v=|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
    return match ? match[1] : line.trim().substring(0, 11);
  }).filter(id => id.length === 11).slice(0, 10);

  if (!ids.length) { showToast('Format URL tidak valid', true); return; }

  document.getElementById('bulk-results').innerHTML = '<div class="loading"><div class="spinner"></div><div>Menganalisis ' + ids.length + ' video dengan AI...</div></div>';

  const data = await ytFetch('videos', { part: 'snippet,statistics,contentDetails', id: ids.join(',') });
  if (!data?.items) return;

  let html = '';
  for (const item of data.items) {
    const vph = calcVPH(item.statistics.viewCount, item.snippet.publishedAt);
    const viral = calcViralScore(vph, item.statistics.viewCount);
    html += `
      <div class="bulk-result">
        <div style="display:flex;gap:12px;align-items:flex-start;margin-bottom:12px;">
          <img src="${item.snippet.thumbnails?.default?.url}" style="width:80px;border-radius:6px;">
          <div>
            <div style="font-weight:600;margin-bottom:4px;">${item.snippet.title}</div>
            <div style="font-size:12px;color:var(--text2);">${item.snippet.channelTitle}</div>
            <div class="video-stats" style="margin-top:6px;">
              <div class="stat highlight">👁 ${formatNum(item.statistics.viewCount)}</div>
              <div class="stat green">⚡ ${formatNum(vph)} VPH</div>
              <div class="stat">Viral: ${viral}/100</div>
            </div>
          </div>
        </div>
        <div id="bulk-ai-${item.id}" style="font-size:12px;color:var(--text2);">Memuat analisis AI...</div>
      </div>`;
  }
  document.getElementById('bulk-results').innerHTML = html;
  state.analyzed += ids.length;
  localStorage.setItem('stat_analyzed', state.analyzed);
  updateStats();

  // AI analysis for each
  for (const item of data.items) {
    const lang = state.settings.lang === 'id' ? 'Bahasa Indonesia' : 'English';
    const prompt = `Analisis video YouTube ini dalam ${lang} secara singkat (3-4 kalimat):
Judul: ${item.snippet.title}
Channel: ${item.snippet.channelTitle}
Views: ${formatNum(item.statistics.viewCount)}
Likes: ${formatNum(item.statistics.likeCount)}
VPH: ${calcVPH(item.statistics.viewCount, item.snippet.publishedAt)}
Berikan insight tentang: potensi viral, kekuatan konten, dan saran singkat.`;
    
    const analysis = await geminiAsk(prompt);
    const el = document.getElementById('bulk-ai-' + item.id);
    if (el) el.innerHTML = `<div style="color:var(--text);margin-top:8px;padding-top:8px;border-top:1px solid var(--border);">🤖 ${analysis}</div>`;
  }
}

